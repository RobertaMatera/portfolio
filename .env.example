# Copy to .env.local for local development; set the same names on Vercel.
# Server-only: none of these use the NEXT_PUBLIC_ prefix, so they never reach the browser.

# Public site address, used for canonical URLs, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact form delivery through Resend (https://resend.com).
RESEND_API_KEY=
# Optional. Defaults to Roberta's address in content/profile.ts.
CONTACT_TO=
# Optional. A sender on a domain verified in Resend; defaults to Resend's test
# sender, which only delivers to the Resend account owner's own address.
CONTACT_FROM=
